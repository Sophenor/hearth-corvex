<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <ApplicationIcon>Hearth.ico</ApplicationIcon>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <Product>Hearth for Corvex</Product>
    <Description>A personal Windows chat companion for Corvex Token Factory</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.html" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <Target Name="RemoveUnusedWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
